{
  "name": "@repo/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./components/*": "./src/lib/components/ui/*/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./hooks/*": "./src/lib/hooks/*.ts",
    ".": "./src/lib/index.ts",
    "./*": {
      "types": "./src/*",
      "svelte": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "ui:add": "shadcn-svelte add",
    "ui:update": "shadcn-svelte update ",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postui:add": "node scripts/update-ui-exports.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/svelte": "^1.1.5",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
