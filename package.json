{
  "name": "publishing-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:remote": "turbo run dev --filter=web --filter=@web-si/tunnel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "ui:add": "bun run --filter @workspace/ui ui:add",
    "postui:add": "bun run --filter @workspace/ui postui:add"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
